---
import ProjectCard from './ProjectCard.astro';

const projects = [
    {
        title: 'BikeOmeter',
        url: 'https://github.com/ZakRabaza/BikeOmeter.git',
        desc: 'Mobile application',
        image: '/images/bikeometer.png',
        category: 'App',
        technologies: ['Java','ReactNative','PostgreSQL','AWS'],
    },
    {
        title: 'FlappyB',
        url: 'https://github.com/ZakRabaza/2026_01_20_FlappyB',
        desc: 'Unity Game',
        image: '/images/flappyb.png',
        category: 'Game',
        technologies: ['Unity', 'C#'],
    },
    {
        title: 'Spire The Slayer',
        url: 'https://github.com/ZakRabaza/spire_the_slayer.git',
        desc: 'Backend project',
        image: '/images/spiretheslayer.png',
        category: 'Backend',
        technologies: ['Python', 'PostgreSQL'],
    },
    {
        title: 'Portfolio',
        url: 'https://github.com/ZakRabaza/ZakRabaza.github.io',
        desc: 'Personal portfolio built with Astro',
        image: 'https://placehold.co/640x360/ebdbb2/3c3836?text=Portfolio',
        category: 'Web',
        technologies: ['Astro', 'TypeScript', 'CSS', 'HTML'],
    },

];
---

<div class="projects-page">
    <h1>Projects</h1>

    <div class="project-grid">
        {projects.map(p => (
                <ProjectCard
                        title={p.title}
                        url={p.url}
                        desc={p.desc}
                        image={p.image}
                        category={p.category}
                        technologies={p.technologies}
                />
        ))}
    </div>
</div>

<style>
    .projects-page {
        max-width: 900px;
    }

    .projects-page h1 {
        font-size: 1.8rem;
        color: var(--orange);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 2rem;
    }

    .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
    }
</style>