---
import Background from './Background.astro';
import NavButton from './NavButton.astro';
import { House, FolderOpen } from '@lucide/astro';

interface Props {
    active: 'home' | 'projects';
}
const { active } = Astro.props;
---

<nav class="sidebar">
    <Background variant="absolute" />

    <div class="sidebar-content">
        <div class="sidebar-logo">Zakariya</div>

        <NavButton href="/" label="Home" active={active === 'home'}>
            <House size={18} stroke-width={2} />
        </NavButton>

        <NavButton href="/projects" label="Projects" active={active === 'projects'}>
            <FolderOpen size={18} stroke-width={2} />
        </NavButton>

    </div>
</nav>

<style>
    .sidebar {
        position: relative;
        width: 200px;
        flex-shrink: 0;
        margin: 1.5rem 0 1.5rem 1.5rem;
        border-radius: 16px;
        overflow: hidden;
    }

    .sidebar-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 1rem 0.75rem;
    }

    .sidebar-logo {
        font-size: 1.1rem;
        font-weight: bold;
        color: var(--orange);
        letter-spacing: 0.1em;
        padding: 0.5rem 0.75rem 0.75rem;
    }

</style>