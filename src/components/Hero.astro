---
interface Props {
    name: string;
    description: string;
}
const { name, description } = Astro.props;
---

<div class="hero">
    <h1>Hello, I am {name} o/</h1>
    <p>{description}</p>

</div>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: safe center;
        height: 100%;
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }

    .hero h1 {
        font-size: 2.5rem;
        color: var(--orange);
        letter-spacing: 0.08em;
        margin-bottom: 1rem;
    }

    .hero p {
        color: var(--muted);
        line-height: 1.7;
        text-align: justify;
    }
</style>