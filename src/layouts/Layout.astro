---
import '../styles/index.css';

interface Props {
    title: string;
    active: 'home' | 'projects';
}
const { title, active } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
</head>
<body>
<div class="app">

    <nav class="sidebar">
        <div class="sidebar-logo">Zakariya</div>
        <a href="/" class={`nav-btn ${active === 'home' ? 'active' : ''}`}>
            <span class="nav-icon">🏠</span>
            <span class="nav-label">Home</span>
        </a>
        <a href="/projects" class={`nav-btn ${active === 'projects' ? 'active' : ''}`}>
            <span class="nav-icon">📁</span>
            <span class="nav-label">Projects</span>
        </a>
    </nav>

    <main class="content">
        <slot />
    </main>

</div>
</body>
</html>